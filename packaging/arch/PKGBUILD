# Local prebuilt-binary package. Build release executable on Arch/CachyOS first.
pkgname=persona3-wallpaper
pkgver=0.1.0
pkgrel=1
pkgdesc='Animated and static wallpaper manager for Linux (beta)'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'ffmpeg')
optdepends=('mpvpaper: animated wallpapers in Hyprland/Sway' 'swaybg: static wallpapers in Sway' 'xwinwrap: animated wallpapers on X11' 'python: cursor archive import')
source=('persona3-wallpaper' 'persona3-wallpaper.desktop' 'persona3-wallpaper.png')
sha256sums=('SKIP' 'SKIP' 'SKIP')
options=('!strip')

package() {
    install -Dm755 "$srcdir/persona3-wallpaper" "$pkgdir/usr/bin/persona3-wallpaper"
    install -Dm644 "$srcdir/persona3-wallpaper.desktop" "$pkgdir/usr/share/applications/persona3-wallpaper.desktop"
    install -Dm644 "$srcdir/persona3-wallpaper.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/persona3-wallpaper.png"
}
